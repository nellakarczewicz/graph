# Nazwa pliku wykonywalnego
TARGET = program

# Kompilator i flagi
CC = gcc
CFLAGS = -Wall -Wextra -std=c11
LDFLAGS = -lm

# Lista plików źródłowych (.c) i obiektowych (.o)
SRCS = main.c layout_tutte.c fruchterman.c io.c
OBJS = $(SRCS:.c=.o)

# Domyślna zasada: budowanie programu
all: $(TARGET)

# Linkowanie plików obiektowych w gotowy program
$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) $(OBJS) -o $(TARGET) $(LDFLAGS)

# Kompilacja każdego pliku .c do .o
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Czyszczenie plików tymczasowych
clean:
	rm -f $(OBJS) $(TARGET)

# Uruchomienie z przykładowymi parametrami (opcjonalnie)
run_tutte: all
	./$(TARGET) -i test.txt -o wynik.txt -a tutte

run_fru: all
	./$(TARGET) -i test.txt -o wynik.txt -a fruchterman
# Pomoc dla programisty (Zasady pisowni i komendy)
help:
	@echo "============================================================"
	@echo " ŚCIĄGAWKA DLA PROGRAMISTOW I TESTEROW (MAKE HELP):"
	@echo "============================================================"
	@echo " Kompilacja:  make"
	@echo " Czyszczenie: make clean"
	@echo " Uruchomienie Tutte:  ./$(TARGET) -i test.txt -o out.txt -a tutte"
	@echo " Uruchomienie Fru:    ./$(TARGET) -i test.txt -o out.txt -a fruchterman"
	@echo ""
	@echo " ZASADY PISOWNI W PLIKU WEJŚCIOWYM (.txt):"
	@echo " -> Format: Nazwa;ID_Start;ID_End;Waga"
	@echo " -> Nazwa:  Małe litery i cyfry, max 10 znaków, bez spacji."
	@echo " -> ID:     Liczby od 1 do 1000."
	@echo " -> Waga:   Liczba z kropką (np. 1.00)."
	@echo "============================================================"

.PHONY: help